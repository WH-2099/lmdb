{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PageConfig",
  "type": "object",
  "properties": {
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PageSource"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pages"
  ],
  "$defs": {
    "DocumentKind": {
      "type": "string",
      "enum": [
        "release_blog",
        "model_card",
        "model_page",
        "documentation",
        "directory"
      ]
    },
    "Format": {
      "type": "string",
      "enum": [
        "html",
        "markdown",
        "pdf"
      ]
    },
    "PageSource": {
      "type": "object",
      "properties": {
        "format": {
          "$ref": "#/$defs/Format"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DocumentKind"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repository": {
          "anyOf": [
            {
              "$ref": "#/$defs/RepositorySource"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "vendor",
        "kind",
        "url",
        "format",
        "records"
      ]
    },
    "RepositoryRevision": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "tracked"
            },
            "reference": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "mode",
            "reference"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "pinned"
            },
            "sha": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "mode",
            "sha"
          ]
        }
      ]
    },
    "RepositorySource": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "repo": {
          "description": "Hugging Face model repository, including its organization.",
          "type": "string"
        },
        "revision": {
          "$ref": "#/$defs/RepositoryRevision"
        }
      },
      "additionalProperties": false,
      "required": [
        "repo",
        "path",
        "revision"
      ]
    }
  }
}
